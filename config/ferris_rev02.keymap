#undef ZMK_BEHAVIORS_KEEP_ALL

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/*    chosen {
        zmk,matrix-transform = &default_transform;
    };
*/

&mt {
    flavor = "tap-preferred";
    tapping_term_ms = <200>;
};

// Using layer taps on thumbs, having quick tap as well helps w/ repeating space/backspace
&lt { quick-tap-ms = <200>; };

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp Q      &kp W      &kp E       &kp R          &kp T         &kp Y            &kp U          &kp I       &kp O       &kp P
                &hm LSHFT A &hm LCTRL S &hm LALT D &hm LGUI F    &kp G         &kp H            &hm RGUI J     &hm RALT K  &hm RCTRL L &hm RSHFT SQT
                &kp Z      &kp X      &kp C       &kp V          &kp B         &kp N            &kp M          &kp COMMA   &kp DOT     &kp FSLH
                                                &lt 1 SPACE  &kp TAB     &kp ENTER  &lt 2 BSPC
            >;
        };

        sym_layer {
            bindings = <
                &kp GRAVE   &kp LT      &kp GT     &kp MINUS     &kp PIPE      &kp DLLR         &kp LBRC      &kp RBRC   &kp CARET   &kp COLON
                &hm LSHFT EXCL &hm LCTRL STAR &hm LALT FSLH &hm LGUI EQUAL     &kp AMPS         &kp HASH      &hm RGUI LPAR  &hm RALT RPAR  &hm RCTRL SEMI &hm RSHFT SQT
                &kp TILDE   &kp PLUS    &kp LBK    &kp RBKT      &kp PRCNT     &kp AT           &kp UNDER     &kp COMMA   &kp DOT    &kp FSLH
                                                   &trans  &kp TAB     &kp ESC  &kp BSPC
            >;
        };

        num_layer {
            bindings = <
                &kp LBKT   &kp N1     &kp N2      &kp N3      &kp RBKT      &trans      &trans      &trans      &trans     &trans
                &kp LSHFT  &kp N4     &kp N5      &kp N6      &kp EQUAL     &LEFT       &DOWN       &RIGHT      &UP        &trans
                &kp LC(UP) &kp N7     &kp N7      &kp N9      &kp BSLH      &trans      &trans      &trans      &trans     &trans
                                                  &kp N0      &kp LGUI      &trans      &trans
            >;
        };

    };
};
